@model Adopcion

@{
    ViewData["Title"] = "Details";
}

<h1>Detalles de la Adopción</h1>

<div>
    <h4>Información de la Mascota</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.Mascota.NombreMascota</dd>

        <dt class="col-sm-2">Tipo</dt>
        <dd class="col-sm-10">@Model.Mascota.Tipo</dd>

        <dt class="col-sm-2">Edad</dt>
        <dd class="col-sm-10">@Model.Mascota.Edad años</dd>

        <dt class="col-sm-2">Estado de Adopción</dt>
        <dd class="col-sm-10">@Model.Mascota.EstadoAdopcion</dd>

        @if (!string.IsNullOrEmpty(Model.Mascota.ImageURL))
        {
            <dt class="col-sm-2">Imagen</dt>
            <dd class="col-sm-10">
                <img src="@Model.Mascota.ImageURL" alt="Imagen de mascota" style="max-width:300px;" />
            </dd>
        }
    </dl>

    <h4>Información del Adoptante</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.Adoptante.NombreAdoptante</dd>

        <dt class="col-sm-2">Correo Electrónico</dt>
        <dd class="col-sm-10">@Model.Adoptante.CorreoElectronico</dd>
    </dl>
</div>

<div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Edit" asp-route-id="@Model?.AdopcionId">Editar</a>} |
    <a asp-action="Index">Regresar a la lista</a>
</div>
