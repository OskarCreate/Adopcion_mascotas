@model IEnumerable<Adoptante>

@{
    ViewData["Title"] = "Index";
}

<h1>Adoptantes</h1>

<p>
    <a asp-action="Create">Crear nuevo adoptante</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NombreAdoptante)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CorreoElectronico)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.NombreAdoptante)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CorreoElectronico)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.AdoptanteId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.AdoptanteId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.AdoptanteId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
